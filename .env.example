# LLM (configurable, sin valores reales)
LLM_PROVIDER=gemini  # gemini u openai
LLM_MODEL=  # opcional; por defecto gemini-3.1-flash-lite / gpt-4o-mini
LLM_API_KEY=  # opcional, clave genérica; también puedes usar GEMINI_API_KEY u OPENAI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub (token fine-grained, un solo repo, permisos mínimos)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
BASE_BRANCH=main
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# dbt (sin conexión al warehouse)
DBT_PROJECT_DIR=dbt
DBT_MANIFEST_PATH=dbt/target/manifest.json
DBT_PROFILES_DIR=ci

# Persistencia
SQLITE_PATH=data/agent.db
